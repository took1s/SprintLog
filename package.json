{
  "name": "sprintlog-frontend",
  "private": true,
  "version": "3.0.0",
  "description": "Build-Tooling f\u00fcr das SprintLog-Frontend (Tailwind-Build, Vendor-Libs, Unit-Tests). Die App selbst l\u00e4uft ohne Bundler.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./frontend/tailwind.css -o ./SprintLog.Api/wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ./frontend/tailwind.css -o ./SprintLog.Api/wwwroot/css/app.css --watch",
    "vendor": "node ./frontend/copy-vendor.mjs",
    "build": "npm run vendor && npm run build:css",
    "test": "node --test \"frontend/tests/*.test.js\"",
    "mock": "node ./frontend/dev/mock-api.mjs",
    "mock:demo": "node ./frontend/dev/mock-api.mjs --demo",
    "test:e2e": "node --test frontend/e2e/app.e2e.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.1",
    "chart.js": "4.4.7",
    "playwright": "1.55.0",
    "tailwindcss": "3.4.17",
    "vue": "3.5.13"
  },
  "engines": {
    "node": ">=22"
  }
}
