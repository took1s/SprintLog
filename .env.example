# Kopieren nach .env und Werte anpassen. Die .env-Datei wird NICHT eingecheckt.

# Signierschlüssel für JWT - mindestens 32 Zeichen, zufällig.
# Erzeugen z. B. mit:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-characters

# Passwort der lokalen PostgreSQL (docker compose)
POSTGRES_PASSWORD=sprintlog

# Nur für "dotnet run" ohne Docker (z. B. gegen Supabase):
# ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require
# Database__MigrateOnStartup=false
