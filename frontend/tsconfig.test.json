{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"],
    // Test-Fixtures sind bewusst knappe Objekt-Literale (Teilobjekte, null-Prüfung per assert).
    // Typgeprüft wird trotzdem: falsche Importe, unbekannte Funktionen und falsche Argumenttypen fallen auf.
    "strict": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"],
  "exclude": ["src/sw.ts"]
}
